# LLM
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Demo：无数据源时返回内置样例（显式标注，仅用于开箱预览）
DEMO_MODE=false

# Database
DATABASE_URL=sqlite:///./shopping_agent.db

# Kimi 浏览器扩展（无联盟 API key 时用真实浏览器采集，需先装扩展并登录各平台）
WEBBRIDGE_ENABLED=true
WEBBRIDGE_BASE_URL=http://127.0.0.1:10086

# Search
TAVILY_API_KEY=

# Platform API（缺项则不启用该来源，绝不回退到假数据）
JD_UNION_APP_KEY=
JD_UNION_APP_SECRET=
TBK_APP_KEY=
TBK_APP_SECRET=
TBK_ADZONE_ID=
PDD_CLIENT_ID=
PDD_CLIENT_SECRET=
PDD_PID=
PDD_CUSTOM_PARAMETERS=
